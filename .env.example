# Copy to .env and edit. NEVER commit .env.
APP_ENV=demo                      # "demo" or "production" (production refuses weak/missing secrets and hides /docs)

# REQUIRED in production: python -c "import secrets;print(secrets.token_urlsafe(48))"
# In demo mode a random key is generated into .runtime_secret if this is empty.
SECRET_KEY=

DATABASE_URL=sqlite:///./darkcrimenet.db
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_UPLOAD_MB=25
# EVIDENCE_DIR=./evidence_store

# Bootstrap accounts (only used when the users table is empty). Leave blank to get random
# passwords printed once and written to initial_credentials.txt. Change later with:
#   python scripts/set_password.py <username>
ADMIN_PASSWORD=
INVESTIGATOR_PASSWORD=            # demo mode only
SUPERVISOR_PASSWORD=              # demo mode only

# Brute-force limits and anomaly thresholds (uncalibrated heuristics)
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
ANOMALY_REVIEW_THRESHOLD=62
ANOMALY_HIGH_THRESHOLD=80

# Optional Neo4j connection
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# Data integrity ledger (see docs/guide/data-integrity.md)
LEDGER_ANCHOR_EVERY=50            # a Merkle anchor block every N blocks (also created lazily after LEDGER_ANCHOR_SECONDS, on demand and on bundle download)
LEDGER_ANCHOR_SECONDS=3600
LEDGER_KEY_PATH=                  # default: .ledger_ed25519 in the project root (next to the database for isolated installs). Never commit it.
EXPORT_ALERT_THRESHOLD=10         # more than this many exports/downloads by one user ...
EXPORT_ALERT_WINDOW_MINUTES=10    # ... within this many minutes notifies admins and supervisors
EVIDENCE_ENCRYPTION_KEY=          # optional: base64 32-byte key (or Fernet key); newly stored evidence files are encrypted at rest

# Automatic social-media collection (all optional). A provider with no key is simply unavailable in the Collect tab.
# Use only official API keys your unit is entitled to hold. Nothing is scraped and no account is logged into.
X_BEARER_TOKEN=
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=DARK-CRIMENET/5.3 by <your unit>
MASTODON_INSTANCE=mastodon.social
MASTODON_TOKEN=                   # only needed for keyword search on some servers
SOCIAL_AUTOCOLLECT=true           # run saved repeat searches in the background
SOCIAL_COLLECT_MIN_MINUTES=15     # a repeat search may not run more often than this
